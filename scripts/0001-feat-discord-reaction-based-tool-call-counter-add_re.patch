diff --git a/gateway/run.py b/gateway/run.py
index e418d119..084c308c 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -4697,6 +4697,24 @@ class GatewayRunner:
         # Accumulates tool lines into a single message that gets edited
         _progress_metadata = {"thread_id": source.thread_id} if source.thread_id else None
 
+        # Emoji progression for Discord reaction-based tool call counter (1–60)
+        # Each emoji covers a range: groups of 5 up to 60, then a cap emoji
+        _REACTION_EMOJIS = [
+            "1️⃣", "2️⃣", "3️⃣", "4️⃣", "5️⃣",       # 1–5
+            "6️⃣", "7️⃣", "8️⃣", "9️⃣", "🔟",           # 6–10
+            "🔑", "🔒", "🔓", "🔔", "🔕",             # 11–15
+            "⚡", "🌊", "🔥", "❄️", "🌀",              # 16–20
+            "🎯", "🎲", "🎮", "🎸", "🎺",              # 21–25
+            "🚀", "🛸", "🌙", "⭐", "🌟",              # 26–30
+            "🦁", "🐉", "🦅", "🐺", "🦊",             # 31–35
+            "💎", "🏆", "⚔️", "🛡️", "🗡️",             # 36–40
+            "🌈", "🌸", "🍀", "🌺", "🌻",             # 41–45
+            "🔮", "💫", "✨", "🌠", "🎇",              # 46–50
+            "🧩", "🧬", "⚗️", "🔭", "🧲",             # 51–55
+            "🏔️", "🌋", "🗻", "🏝️", "🌊",             # 56–60
+        ]
+        _REACTION_CAP = "💯"  # shown at 60+
+
         async def send_progress_messages():
             if not progress_queue:
                 return
@@ -4705,6 +4723,39 @@ class GatewayRunner:
             if not adapter:
                 return
 
+            # Discord: use emoji reactions on the user's original message instead of
+            # sending text — non-intrusive heartbeat showing tool call count.
+            if source.platform == Platform.DISCORD and event.message_id and hasattr(adapter, "add_reaction"):
+                tool_call_count = 0
+                current_reaction = None
+                while True:
+                    try:
+                        progress_queue.get_nowait()
+                        tool_call_count += 1
+                        idx = min(tool_call_count, len(_REACTION_EMOJIS)) - 1
+                        new_reaction = _REACTION_EMOJIS[idx] if tool_call_count <= len(_REACTION_EMOJIS) else _REACTION_CAP
+                        if new_reaction != current_reaction:
+                            if current_reaction:
+                                await adapter.remove_reaction(source.chat_id, event.message_id, current_reaction)
+                            await adapter.add_reaction(source.chat_id, event.message_id, new_reaction)
+                            current_reaction = new_reaction
+                    except queue.Empty:
+                        await asyncio.sleep(0.3)
+                    except asyncio.CancelledError:
+                        # Drain remaining items
+                        while not progress_queue.empty():
+                            try:
+                                progress_queue.get_nowait()
+                                tool_call_count += 1
+                            except Exception:
+                                break
+                        # Final state: leave the last reaction on so the log is readable
+                        return
+                    except Exception as e:
+                        logger.debug("Reaction progress error: %s", e)
+                        await asyncio.sleep(1)
+                return
+
             progress_lines = []      # Accumulated tool lines
             progress_msg_id = None   # ID of the progress message to edit
             can_edit = True          # False once an edit fails (platform doesn't support it)
